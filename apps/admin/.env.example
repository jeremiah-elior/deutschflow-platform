# Admin/API connection
# For same-domain production, leave VITE_API_BASE_URL empty or set it to your site origin.
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public website
VITE_SITE_URL=https://deutschflow.app
VITE_SUPPORT_EMAIL=support@deutschflow.app
VITE_PRIVACY_EMAIL=privacy@deutschflow.app

# Required before publishing the Impressum/privacy policy.
VITE_LEGAL_NAME=REPLACE_WITH_LEGAL_NAME
VITE_LEGAL_STREET=REPLACE_WITH_STREET_AND_NUMBER
VITE_LEGAL_CITY=REPLACE_WITH_POSTCODE_AND_CITY
VITE_LEGAL_COUNTRY=Germany

# Add these when the store listings are live. Leave blank until then.
VITE_GOOGLE_PLAY_URL=
VITE_APP_STORE_URL=
