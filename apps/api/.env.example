PORT=8080
NODE_ENV=production
CORS_ORIGIN=https://mydeutschflow.de
PUBLIC_APP_BASE_URL=https://mydeutschflow.de

DB_HOST=localhost
DB_PORT=3306
DB_USER=YOUR_MYSQL_USER
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=YOUR_MYSQL_DATABASE
DB_SSL=false

UPLOADS_DIR=uploads/content
ADMIN_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
ADMIN_COOKIE_NAME=df_admin
ENABLE_DEV_ADMIN_BYPASS=false

# DeutschFlow Read + Speak (server-side only)
GOOGLE_SPEECH_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_TTS_VOICE=de-DE-Chirp3-HD-Leda
GOOGLE_TTS_SPEAKING_RATE=0.86
SPEECH_UPLOAD_MAX_BYTES=2500000
